# Copy this file to ".env" and fill in your real values.
# NEVER commit the real ".env" file to git - only this .example file is safe to share.

# ---- Azure Storage ----
AZURE_STORAGE_ACCOUNT_NAME=openaifilesearch
AZURE_STORAGE_ACCOUNT_KEY=<YOUR_STORAGE_ACCOUNT_KEY>
AZURE_STORAGE_CONTAINER_NAME=YOUR_CONTAINER_NAME

# Optional: only download blobs under this folder/prefix inside the container.
# Leave blank to download every supported file in the container.
AZURE_STORAGE_BLOB_PREFIX=

# ---- Microsoft Foundry (Azure OpenAI-compatible endpoint) ----
FOUNDRY_ENDPOINT=https://Web-Portal-Foundry-Test.services.ai.azure.com/openai/v1
FOUNDRY_DEPLOYMENT_NAME=gpt-4.1

# ---- Vector store ----
VECTOR_STORE_NAME=azure-files-vector-store
